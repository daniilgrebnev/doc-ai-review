# The app supports two LLM providers; configure one or both.
# WITHOUT any keys the app runs in DEMO MODE with pre-generated responses.

# --- Claude (Anthropic) ---
# Get it at: https://platform.claude.com/settings/keys

ANTHROPIC_API_KEY=

# Optional: model id (default: claude-haiku-5-5)
# Examples: claude-haiku-5-5 | claude-sonnet-5-5 | claude-opus-5-5
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: reasoning effort — low | medium | high | xhigh | max (default: medium)
ANTHROPIC_EFFORT=medium

# --- YandexGPT (Yandex Cloud) ---
# https://console.cloud.yandex.ru — service account with role ai.languageModels.user
YC_API_KEY=
YC_FOLDER_ID=
# Model slug, URI built as gpt://{YC_FOLDER_ID}/{slug}/latest
YANDEX_CLOUD_MODEL=yandexgpt-5.1/latest

# --- DeepSeek ---
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# deepseek-chat (V3) | deepseek-reasoner (R1)
DEEPSEEK_MODEL=deepseek-chat

# --- Geo lock ---
# Claude is disabled for users from these countries (ISO codes, comma-separated). Default: RU
CLAUDE_BLOCKED_COUNTRIES=RU
# Local testing only: pretend the request comes from this country (e.g. RU)
# GEO_COUNTRY_OVERRIDE=
