# Anthropic API key for Claude
# Get it at: https://platform.claude.com/settings/keys
#
# WITHOUT the key the app runs in DEMO MODE with pre-generated responses.
# Perfect for Vercel deploy and portfolio demos.

ANTHROPIC_API_KEY=

# Optional: model id (default: claude-haiku-5-5)
# Examples: claude-haiku-5-5 | claude-sonnet-5-5 | claude-opus-5-5
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: reasoning effort — low | medium | high | xhigh | max (default: medium)
ANTHROPIC_EFFORT=medium
