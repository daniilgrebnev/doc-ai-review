# Yandex Cloud credentials for YandexGPT API
# Get them at: https://console.cloud.yandex.ru
#
# WITHOUT these keys the app runs in DEMO MODE with pre-generated responses.
# Perfect for Vercel deploy and portfolio demos.

YC_API_KEY=
YC_FOLDER_ID=

# Model slug (NOT yandexgpt-pro — that slug does not exist!)
# URI built as: gpt://{YC_FOLDER_ID}/{slug}/latest
# Examples: yandexgpt-5.1/latest | yandexgpt | yandexgpt-lite
YANDEX_CLOUD_MODEL=yandexgpt-5.1/latest
